# Copiez ce fichier en ".env" et remplissez pour activer les envois réels.
# Sans configuration, l'application fonctionne en mode simulation :
# les notifications sont visibles dans l'onglet Notifications de l'espace pro.

# --- Email (SMTP) — ex : Gmail, Brevo, OVH... ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Ninna Beauty <ninna@exemple.fr>

# --- WhatsApp (via Twilio) ---
TWILIO_SID=
TWILIO_TOKEN=
